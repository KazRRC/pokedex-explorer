<h1>
  <%= @pokemon.name.capitalize %>
</h1>
<div class="pokemon-detail">
  <div>
    <% if @pokemon.sprite.present? %>
      <%= image_tag @pokemon.sprite,
          alt: @pokemon.name,
          class: "large-sprite" %>
    <% end %>
  </div>
  <div>
    <h2>
      Pokedex #<%= @pokemon.pokedex_number %>
    </h2>
    <p>
      <strong>Height:</strong>
      <%= @pokemon.height %>
    </p>
    <p>
      <strong>Weight:</strong>
      <%= @pokemon.weight %>
    </p>
    <p>
      <strong>Region:</strong>
      <%= link_to @pokemon.region.name,
          region_path(@pokemon.region) %>
    </p>
    <h3>Types</h3>
    <% @pokemon.types.each do |type| %>

      <span class="type-badge <%= type.name.downcase %>">
        <%= type.name %>
      </span>

    <% end %>
    <h3>Abilities</h3>
    <ul>
      <% @pokemon.abilities.each do |ability| %>
        <li>
          <%= ability.name %>
        </li>
      <% end %>
    </ul>
  </div>
</div>
<br>
<%= link_to "Back to Pokedex",
    pokemon_index_path %>