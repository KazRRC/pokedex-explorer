<h1>Pokédex</h1>

<%= form_with url: pokemon_index_path,
              method: :get,
              local: true do |f| %>

  <div>
    <%= f.label :search, "Search Pokémon" %><br>
    <%= f.text_field :search,
          value: params[:search] %>
  </div>
  <br>
  <div>

    <%= f.label :type_id, "Filter by Type" %><br>

    <%= f.collection_select(
          :type_id,
          @types,
          :id,
          :name,
          { include_blank: "All Types" }
        ) %>

  </div>
  <br>
  <%= f.submit "Apply Filters" %>
<% end %>

<hr>

<ul>
<% @pokemon.each do |pokemon| %>

<div class="pokemon-card">

    <img src="<%= pokemon.sprite %>">

    <h3>
      <%= link_to pokemon.name,
                  pokemon_path(pokemon) %>
    </h3>

    <p>
      #<%= pokemon.pokedex_number %>
    </p>

</div>

<% end %>

<%= paginate @pokemon %>
</ul>

<div class="mt-4">
  <%= paginate @pokemon %>
</div>