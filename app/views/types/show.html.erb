<h1><%= @type.name %> Pokémon</h1>

<p>
  Total Pokémon: <%= @pokemon.count %>
</p>

<ul>
  <% @pokemon.each do |pokemon| %>

    <li>

      <%= image_tag pokemon.sprite,
          width: 50 if pokemon.sprite.present? %>

      <%= link_to pokemon.name, pokemon_path(pokemon) %>

    </li>

  <% end %>
</ul>