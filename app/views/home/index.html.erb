<h1>Pokedex Explorer</h1>

<p>
  Explore Pokemon, types, regions, and abilities.
</p>


<h2>Statistics</h2>

<div class="stats">

  <div class="stat-card">
    <h3><%= @pokemon_count %></h3>
    <p>Pokemon</p>
  </div>


  <div class="stat-card">
    <h3><%= @type_count %></h3>
    <p>Types</p>
  </div>


  <div class="stat-card">
    <h3><%= @region_count %></h3>
    <p>Regions</p>
  </div>

</div>


<h2>Featured Pokemon</h2>

<div class="pokemon-grid">

<% @featured_pokemon.each do |pokemon| %>

  <div class="pokemon-card">

    <%= image_tag pokemon.sprite if pokemon.sprite.present? %>

    <h3>
      <%= link_to pokemon.name,
          pokemon_path(pokemon) %>
    </h3>

    <p>
      #<%= pokemon.pokedex_number %>
    </p>

  </div>

<% end %>

</div>


<br>

<%= link_to "Find a Random Pokemon",
    random_path,
    class: "button" %>