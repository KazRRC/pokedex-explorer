<div class="text-center">

  <h1 class="display-4">Pokédex Explorer</h1>

  <p class="lead">
    Browse the first 151 Pokémon from the Kanto region.
  </p>

</div>

<div class="row mt-5">

  <div class="col-md-4">

    <div class="card text-center">

      <div class="card-body">

        <h2><%= @pokemon_count %></h2>

        <p>Pokemon</p>

      </div>

    </div>

  </div>

  <div class="col-md-4">

    <div class="card text-center">

      <div class="card-body">

        <h2><%= @type_count %></h2>

        <p>Types</p>

      </div>

    </div>

  </div>

  <div class="col-md-4">

    <div class="card text-center">

      <div class="card-body">

        <h2><%= @ability_count %></h2>

        <p>Abilities</p>

      </div>

    </div>

  </div>

</div>